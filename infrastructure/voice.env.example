# Pass explicitly: --env-file infrastructure/voice.env.example
# Replace these documentation IPs with the PC LAN and ESP32 IPv4 addresses.
VOICE_LISTEN_IP=192.0.2.10
VOICE_DEVICE_IP=192.0.2.20
# Docker Desktop forwards UDP using the Docker bridge gateway as source.
# The PowerShell launcher detects that gateway. Set this explicitly for direct
# Compose use; native Linux usually preserves the original device source.
# VOICE_UDP_SOURCE_IP=172.23.0.1
VOICE_OLLAMA_PORT=11435
